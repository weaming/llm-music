# 复制为 .env 后填入真实值。程序只读进程环境，不会自动加载本文件。
#   bash/zsh:  set -a; source .env; set +a
#   fish:      export (grep -vE '^#|^\s*$' .env)

# 上游 LLM 凭据（必填）
OPENAI_API_KEY=sk-xxxxxxxx

# 上游 base_url，OpenAI 兼容即可（含 /v1）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 默认模型：客户端未在请求体里给 model 时用它
OPENAI_MODEL=deepseek-flash

# 监听端口；与 tap-player 的默认 tap 地址一致
LLM_SERVER_PORT=3050

# 用量日志（jsonl，追加写），目录会自动创建
LLM_USAGE_LOG_PATH=./logs/llm-usage.jsonl

# 可选：上游 HTTPS 代理，留空则回退标准代理环境变量
# OPENAI_PROXY=http://localhost:7890
